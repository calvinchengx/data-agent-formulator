# Copy to .env. Every key here is named in docs/00-plan.md §11, and `make test`
# fails if that stops being true in either direction -- a document naming a
# setting that does not exist reads as deployable, and a setting nothing
# documents is one nobody can decide about.
#
# Discipline, as one level up: switching environments is THIS file only. No
# code path knows which one it is in.

# ---- dependency pins (the BOM) ----------------------------------------------
# Data Formulator is consumed, never forked. This is the pin the ExternalDataLoader
# interface in docs/00-plan.md §3 must be re-read against before the loader is
# written -- that section was read from `main`, which is ahead of this release.
DATA_FORMULATOR_VERSION=0.7.0

# ---- where Data Formulator looks for the plugin ------------------------------
# Discovery order is DF_PLUGIN_DIR, then DATA_FORMULATOR_HOME/plugins, then
# ~/.data_formulator/plugins. Naming the first means the other two never
# decide anything.
DF_PLUGIN_DIR=./plugin
# Deliberately empty. Plugin scanning is already on in local mode; this is how
# a HOSTED deployment opts in, and a plugin is arbitrary Python in the server
# process. See SECURITY.md.
DF_ALLOW_PLUGINS=
# Deliberately unset. It is Data Formulator's own second discovery location and
# setting it would give the plugin two homes with a precedence rule between
# them. It appears here so the decision is written down rather than implied by
# an absence, and so one rule covers every name a document mentions.
DATA_FORMULATOR_HOME=

# ---- the upstream stack ------------------------------------------------------
# data-agent-service is consumed, not run, from here: the loader reaches its
# executor through the gateway exactly as any other non-MCP client does.
DAS_STACK_NETWORK=data-agent-service_default
# The gateway as a WORKSTATION sees it. Data Formulator runs on the laptop, not
# inside the stack's network, so this is the host-published port (8446) and not
# the in-network one (apim-emulator:8445) that upstream's own services use.
DAF_APIM_BASE=https://localhost:8446
DAF_WAREHOUSE_REST_PATH=/warehouse-rest
# Present because the fallback in docs/00-plan.md §5 must have a home, not
# because it is used. If the bearer does not survive /warehouse-rest, the
# loader speaks MCP and DAF_EXECUTOR_SURFACE changes here.
DAF_WAREHOUSE_MCP_PATH=/warehouse/mcp
DAF_EXECUTOR_SURFACE=rest
# Which source to browse. Empty means ask GET /sources.
DAF_SOURCE=

# ---- identity ----------------------------------------------------------------
# The caller's own bearer and nothing else. `make login` runs the device-code
# flow and writes the token to DAF_TOKEN_FILE at mode 0600; the loader reads it
# per call. It is never a Data Formulator param, because params are persisted
# to the workspace and a token's lifetime is not the workspace's (§6).
# Local development only: the emulator family serves self-signed certificates.
# A production configuration does not set this.
DAF_TLS_INSECURE=true
DAF_AUTHORITY=https://localhost:8443
DAF_TENANT=6f89cf12-978b-4d23-ac18-9ef0c127cf87
DAF_CLIENT_ID=189c7070-78a3-4c13-aa18-20a2ca5755ca
DAF_SCOPE=api://data-agent-service/access_as_user
DAF_TOKEN_FILE=./.token
# The witnesses' own password grant against the development tenant, mirroring
# upstream's harness. Seeded, published, and reachable only on a local stack --
# it is not a credential this repository protects. `make login` does not use it.
DAF_TEST_PASSWORD=Password1!

# ---- what the loader is allowed to ask for -----------------------------------
# The executor applies its own ceiling regardless; this one stops a browse in
# the UI from asking for a warehouse.
DAF_MAX_ROWS=10000
