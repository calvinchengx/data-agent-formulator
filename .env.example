# Copy to .env. Every DAF_* key is read by the loader or a harness in this
# repository; DF_* keys are Data Formulator's own and are set here so that one
# file says where the plugin lives and what it may reach.
#
# Discipline, as one level up: switching environments is THIS file only. No
# code path knows which one it is in.

# ---- dependency pins (the BOM) ----------------------------------------------
# Data Formulator is consumed, never forked. The loader is an out-of-tree
# plugin, so this pin is the version its ExternalDataLoader base class and its
# plugin-discovery rules were read from. Moving it is a reviewed change.
DATA_FORMULATOR_VERSION=unpinned-see-docs-parity

# ---- where Data Formulator looks for the plugin ------------------------------
# Discovery order is DF_PLUGIN_DIR, then DATA_FORMULATOR_HOME/plugins, then
# ~/.data_formulator/plugins. Naming the first means the other two never
# decide anything.
DF_PLUGIN_DIR=./plugin

# ---- the upstream stack ------------------------------------------------------
# data-agent-service is consumed, not run, from here: the loader reaches its
# executor through the gateway exactly as any other client does.
DAS_STACK_NETWORK=data-agent-service_default
DAF_APIM_BASE=https://apim-emulator:8445
DAF_WAREHOUSE_MCP_PATH=/warehouse/mcp
# Which of the executor's two surfaces the loader speaks -- `mcp` or the REST
# contract in services/contract/openapi.json -- is not decided yet. The design
# doc decides it; until then this key exists so the choice has one home rather
# than being spelled into the loader.
DAF_EXECUTOR_SURFACE=undecided
DAF_SOURCE=

# ---- what the loader is allowed to do ---------------------------------------
# A ceiling the loader asks for. The executor applies its own regardless; this
# one exists so a browse in the UI cannot ask for a warehouse-sized fetch.
DAF_MAX_ROWS=10000
